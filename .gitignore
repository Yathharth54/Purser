# The manual is a controlled document — never commit it.
docs/*.pdf

# Runtime state (her threads, rendered page cache)
var/

# fastembed model cache
.fastembed/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
web/dist/

# Env -- the bare name only matches `.env`, so backups and per-environment
# variants (.env.bak.*, .env.local) would otherwise be committable, keys and all.
.env
.env.*
!.env.example

# macOS
.DS_Store

# TS incremental build info
web/*.tsbuildinfo
.vercel

# embedding model baked in at Vercel build time
.models/
.env*

# The controlled manual, bundled into Vercel deploys -- never commit it.
.manual/
