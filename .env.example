# Model provider. One variable -- swapping providers changes nothing else,
# because `PURSER_MODEL` is passed to pydantic-ai verbatim and it infers the
# provider from the prefix.
#
#   openai:gpt-4o                            the default
#   openrouter:anthropic/claude-sonnet-4.5   any model OpenRouter fronts
#   openrouter:openai/gpt-4o                 the same model, billed via OpenRouter
#
# Set the key for whichever provider you name. The other can stay empty; the
# app fails at startup naming the one it needs.
PURSER_MODEL=openai:gpt-4o
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Access. When set, every /api route except health, session and login answers
# 401 until this passcode is entered once on a device (an HMAC-signed,
# HttpOnly cookie, valid a year). Changing it signs every device out. Leave it
# empty for local development and the app is open.
PURSER_PASSCODE=

# Chats. Unset: a local SQLite file in PURSER_VAR_DIR. On a serverless host,
# whose filesystem does not survive between requests, point this at Postgres
# (Neon on Vercel); postgres:// and postgresql:// URLs both work.
DATABASE_URL=
# How many chats to keep; the least recently used beyond this are pruned.
PURSER_MAX_THREADS=100

# Paths. PURSER_PDF_PATH stays quoted: the manual's filename has spaces, and an
# unquoted copy breaks any shell that sources this file.
PURSER_DATA_DIR=./data
PURSER_VAR_DIR=./var
PURSER_PDF_PATH="./docs/Airbus SEP Manual Issue IX Rev 04 Effective 08th Oct 2025 2.pdf"
